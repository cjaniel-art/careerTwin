# CareerTwin — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# Nenhuma dessas variáveis deve ser commitada com valores reais.
# Ver src/lib/env.ts para o contrato de validação em runtime.

# --- Aplicação ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Auth, Postgres, Storage) ---
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço — uso exclusivo no servidor, nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedor de IA ---
# Usado pelos adapters em src/infrastructure/ai. Sem esta chave, o ambiente de
# produção falha explicitamente ao inicializar o adapter real (ver requireEnv).
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# --- Analytics ---
ANALYTICS_WRITE_KEY=

# --- Limites de upload ---
RESUME_UPLOAD_MAX_MB=5
